#!/usr/bin/env bash

set -euo pipefail

cd "{{ .ProjectSnake }}"

find . -type f -name 'mise.toml' -print0 | xargs -0 mise trust
find . -type f -print0 | xargs -0 chmod -x
find . -type f .config/mise/tasks -print0 | xargs -0 chmod +x
find . -type f .config/mise/tasks -print0 | xargs -0 mise trust

if [[ -d .github/workflows ]]; then
  mise run pinact --update
fi

if command -v rumdl >/dev/null 2>&1; then
  find . -type f -name '*.md' -print0 | xargs 0 rumdl fmt
elif command -v deno >/dev/null 2>&1; then
  find . -type f -name '*.md' -print0 | xargs 0 deno fmt
fi

git init
git add .
